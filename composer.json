{
    "name": "focalcrm/marketing",
    "description": "Email Marketing, Lead Capture Forms, Drip Campaigns, and Analytics for Focal CRM",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "crm",
        "focalcrm",
        "marketing-automation",
        "email-marketing",
        "lead-scoring",
        "forms"
    ],
    "homepage": "https://focalcrm.io",
    "support": {
        "issues": "https://github.com/focalcrm/focal/issues",
        "source": "https://github.com/focalcrm/focal"
    },
    "authors": [
        {
            "name": "CaskStack, LLC",
            "homepage": "https://focalcrm.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "dophp/laravel-mail-builder": "^1.0",
        "focalcrm/core": "self.version",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "filament/forms": "^5.0",
        "focalcrm/sales": "self.version",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0"
    },
    "suggest": {
        "focalcrm/sales": "Enables closed-loop revenue attribution, sales cycle velocity, and automated deal creation"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../sales",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Focal\\Marketing\\": "src/",
            "Focal\\Marketing\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Focal\\Marketing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Focal\\Marketing\\MarketingServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
